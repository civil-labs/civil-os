# Build from the repository root:
#   docker build -f services/database-writer/dockerfile .

# 1. Build stage
FROM golang:1.26.1-alpine3.23 AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
# Build a static binary
RUN CGO_ENABLED=0 GOOS=linux go build -o /app/writer ./services/database-writer

# 2. Run stage
FROM alpine:3.24

# Create a non-root user
RUN adduser -D -u 1001 writeruser

# Copy in the binary
COPY --from=builder --chown=writeruser:writeruser /app/writer /app/writer

RUN wget -qO/bin/grpc_health_probe https://github.com/grpc-ecosystem/grpc-health-probe/releases/download/v0.4.19/grpc_health_probe-linux-amd64 && \
    chmod +x /bin/grpc_health_probe

# Switch to the non-root user
USER 1001

EXPOSE 50052

CMD ["/app/writer"]
