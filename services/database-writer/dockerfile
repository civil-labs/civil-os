# 1. Build Stage
FROM golang:1.26.1-alpine AS builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
# Build a static binary
RUN CGO_ENABLED=0 GOOS=linux go build -o editor .

# 2. Run Stage (Distroless/Alpine)
FROM alpine:latest

# Create a non-root user
RUN adduser -D -u 1001 editoruser

# Copy in the binary
COPY --from=builder --chown=editoruser:editoruser /app/editor /app/editor

RUN wget -qO/bin/grpc_health_probe https://github.com/grpc-ecosystem/grpc-health-probe/releases/download/v0.4.19/grpc_health_probe-linux-amd64 && \
    chmod +x /bin/grpc_health_probe

# Switch to the non-root user
USER 1001

# Document 8080 as the default port 
EXPOSE 8080

CMD ["/app/editor"]