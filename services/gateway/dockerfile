# Build from the repository root:
#   docker build -f services/gateway/dockerfile .

# 1. Build stage
FROM golang:1.26.1-alpine3.23 AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
# Build a static binary
RUN CGO_ENABLED=0 GOOS=linux go build -o /app/gateway ./services/gateway

# 2. Run stage
FROM alpine:3.24

# Create a non-root user
RUN adduser -D -u 1001 gatewayuser

# Copy in the binary
COPY --from=builder --chown=gatewayuser:gatewayuser /app/gateway /app/gateway

# Switch to the non-root user
USER 1001

EXPOSE 8080

CMD ["/app/gateway"]
