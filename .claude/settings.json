{
  "permissions": {
    "deny": [
      "Bash(atlas *)",
      "Bash(mise run db:diff*)",
      "Bash(mise run db:validate*)",
      "Bash(mise db:diff*)",
      "Bash(mise db:validate*)",
      "Bash(docker run *arigaio/atlas*)",
      "Bash(podman run *arigaio/atlas*)",
      "Edit(**/database/migrations/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-gen-edits.sh\""
          }
        ]
      }
    ]
  }
}
